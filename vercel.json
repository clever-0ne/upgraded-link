{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "backend/backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/backend/src/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend"
    }
  ],
  "env": {
    "NEXT_PUBLIC_BACKEND_URL": {
      "description": "Backend API URL for frontend"
    },
    "UNIVERSAL_ADMIN_KEY": {
      "description": "Admin key for universal dashboard"
    },
    "PROJECT_ADMIN_KEY": {
      "description": "Admin key for project dashboard"
    },
    "UNIVERSAL_DATABASE_URL": {
      "description": "Neon PostgreSQL universal database URL"
    },
    "PROJECT_DATABASE_URL": {
      "description": "Neon PostgreSQL project database URL"
    }
  }
}
